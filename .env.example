# Environment Variables — copy to .env and fill in real values

# Runtime PostgreSQL connection string. Use the pooled/serverless connection
# supplied by Neon or Supabase in Vercel production, preview, and development.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE?sslmode=require"

# Direct (non-pooled) PostgreSQL connection used only by Prisma migration commands.
# For local development this can be the same as DATABASE_URL.
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"

# JWT signing secret — use a long random string
JWT_SECRET="CHANGE_ME_TO_A_RANDOM_SECRET_AT_LEAST_32_CHARS"

# Vercel Blob token required for the optional challan-photo upload feature.
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_..."

# Resend API key used to email scheduled and test management reports.
RESEND_API_KEY="re_..."

# Optional but recommended: a verified Resend sender. If omitted, the Resend
# onboarding sender is used, which can only deliver to the account owner.
RESEND_FROM_EMAIL="Suthra Punjab Reports <reports@example.gov.pk>"

# Secret Vercel sends as the Bearer token when invoking the daily report cron.
# Generate a long, random value and configure the same value in Vercel.
CRON_SECRET="CHANGE_ME_TO_A_LONG_RANDOM_SECRET"

# Required only while running `npm run db:seed` to create the first administrator.
# Set these in the one-off shell session, not in Vercel, unless you intentionally
# automate seeding in a separate secure workflow.
ADMIN_USERNAME="initial-admin"
ADMIN_PASSWORD="USE_A_UNIQUE_LONG_PASSWORD"
